# App Settings
PROJECT_NAME="GeoAgent"
ENVIRONMENT="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# LLM Provider Keys
OPENAI_API_KEY="your-openai-api-key-here"
